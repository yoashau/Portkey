<Window x:Class="Portkey.App.TrayPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Portkey.App"
        Title="Portkey" Width="380" Height="456" MaxHeight="456" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource InterfaceFont}" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed" FontSize="15" UseLayoutRounding="True" SnapsToDevicePixels="True" KeyDown="OnKeyDown">
  <Border x:Name="Surface" Background="{DynamicResource PaneBrush}" BorderThickness="0" CornerRadius="22">
    <AdornerDecorator>
    <Grid x:Name="SurfaceContent">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border x:Name="NavigationHeader" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" Padding="12,12,18,8">
        <DockPanel LastChildFill="True">
          <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Click="GoHome" ToolTip="返回" AutomationProperties.Name="返回">
            <Path Style="{StaticResource StrokeIcon}" Width="8" Height="14" Data="M 6.4,1.2 L 1.4,7 L 6.4,12.8" />
          </Button>
          <TextBlock x:Name="PageTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="PageScroll" Grid.Row="1" ClipToBounds="True" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="False">
        <Grid x:Name="Controls" IsEnabled="{Binding NotBusy}" MinHeight="{Binding ActualHeight, ElementName=PageScroll}">
          <Grid.RenderTransform><TranslateTransform x:Name="PageTranslation" /></Grid.RenderTransform>
          <Grid x:Name="HomePage" MinHeight="400" Margin="0,8,0,8">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="18,8,18,16">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <ComboBox x:Name="ServerSelector" ItemsSource="{Binding Servers}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" FontSize="20" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Padding="8,5,32,5" AutomationProperties.Name="选择服务器" />
              <Grid x:Name="ConnectionCard" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,20">
                <StackPanel>
                  <Path x:Name="StatusLogo" Data="{x:Static local:InterfaceArtwork.Link}" Width="26" Height="34" Stretch="Uniform" Fill="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" SnapsToDevicePixels="False" UseLayoutRounding="False" />
                  <TextBlock Text="{Binding Selected.Label}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" ToolTip="{Binding Selected.Detail}" />
                  <TextBlock Text="{Binding Selected.EndpointLabel}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" MaxWidth="310" Margin="0,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Selected.EndpointLabel}">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding Selected.EndpointLabel}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                  <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,20,0,0" Padding="18,12">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <StackPanel x:Name="LocalEndpoint">
                        <TextBlock Text="本地代理" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock x:Name="LocalPortLabel" Text="{Binding Selected.Profile.LocalPort}" Typography.NumeralAlignment="Tabular" FontSize="20" Margin="0,3,0,0" />
                      </StackPanel>
                      <Viewbox x:Name="PortFlow" Grid.Column="1" Height="32" MaxWidth="104" Margin="4,0" Stretch="Uniform" IsHitTestVisible="False" SnapsToDevicePixels="False" UseLayoutRounding="False">
                        <Canvas Width="100" Height="32">
                          <Path Style="{StaticResource StrokeIcon}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" SnapsToDevicePixels="False" UseLayoutRounding="False" Data="M 4,16 C 16,16 20,7 32,7 C 41,7 44,12.5 50,16 C 56,19.5 59,25 68,25 C 80,25 84,16 96,16" />
                          <Path Style="{StaticResource StrokeIcon}" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.8" SnapsToDevicePixels="False" UseLayoutRounding="False" Data="M 4,16 C 16,16 20,25 32,25 C 41,25 44,19.5 50,16 C 56,12.5 59,7 68,7 C 80,7 84,16 96,16" />
                        </Canvas>
                      </Viewbox>
                      <StackPanel x:Name="RemoteEndpoint" Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="服务器端口" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="RemotePortLabel" Text="{Binding Selected.Profile.RemotePort}" Typography.NumeralAlignment="Tabular" FontSize="20" HorizontalAlignment="Right" Margin="0,3,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Grid>
              <Border x:Name="EmptyState" Grid.RowSpan="3" VerticalAlignment="Center" Margin="8,16" Padding="0" Background="Transparent">
                <StackPanel>
                  <Path Data="{x:Static local:InterfaceArtwork.Link}" Width="32" Height="42" Stretch="Uniform" Fill="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left" SnapsToDevicePixels="False" UseLayoutRounding="False" />
                  <TextBlock x:Name="EmptyText" Text="连接你的服务器" FontSize="24" FontWeight="SemiBold" Margin="0,20,0,0" />
                  <TextBlock Text="把本地代理接到远端。" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" />
                  <Button x:Name="AddServerButton" Content="添加服务器" Height="44" Style="{StaticResource AccentButton}" Click="OpenEditor" AutomationProperties.Name="添加服务器" Margin="0,24,0,0" />
                </StackPanel>
              </Border>
              <Grid x:Name="ConnectionActions" Grid.Row="2" Margin="0,32,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                <Button x:Name="ToggleButton" Height="44" Content="{Binding Selected.ToggleLabel}" Style="{StaticResource AccentButton}" Click="ToggleConnection" Margin="0,0,8,0" />
                <Button x:Name="ReconnectButton" Grid.Column="1" Height="44" Padding="0" Click="Reconnect" ToolTip="重新连接" AutomationProperties.Name="重新连接">
                  <Path Style="{StaticResource StrokeIcon}" Width="18" Height="18" Data="M 15,6 A 6.5,6.5 0 1 0 15.4,12 M 15,1.5 L 15,6 L 10.5,6" />
                </Button>
              </Grid>
            </Grid>
            <StackPanel Grid.Row="1">
              <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="18,0,18,6" />
              <Button Style="{StaticResource Nav}" Click="OpenEditor" AutomationProperties.Name="连接设置">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                  <Path Style="{StaticResource StrokeIcon}" Width="17" Height="17" HorizontalAlignment="Left" Stroke="{DynamicResource SecondaryTextBrush}" Data="M 1,4 L 16,4 M 1,12 L 16,12 M 5,1 L 5,7 M 12,9 L 12,15" /><TextBlock Grid.Column="1" Text="连接设置" VerticalAlignment="Center" /><Path Grid.Column="2" Style="{StaticResource StrokeIcon}" Stroke="{DynamicResource SecondaryTextBrush}" Width="7" Height="12" Data="M 1.2,1.2 L 5.8,6 L 1.2,10.8" />
                </Grid>
              </Button>
              <Button Style="{StaticResource Nav}" Click="OpenLogs" AutomationProperties.Name="连接日志">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                  <Path Style="{StaticResource StrokeIcon}" Width="17" Height="17" HorizontalAlignment="Left" Stroke="{DynamicResource SecondaryTextBrush}" Data="M 4,1 L 13,1 Q 15,1 15,3 L 15,14 Q 15,16 13,16 L 4,16 Q 2,16 2,14 L 2,3 Q 2,1 4,1 M 5,5 L 12,5 M 5,8.5 L 12,8.5 M 5,12 L 9,12" /><TextBlock Grid.Column="1" Text="连接日志" VerticalAlignment="Center" /><Path Grid.Column="2" Style="{StaticResource StrokeIcon}" Stroke="{DynamicResource SecondaryTextBrush}" Width="7" Height="12" Data="M 1.2,1.2 L 5.8,6 L 1.2,10.8" />
                </Grid>
              </Button>
            </StackPanel>
          </Grid>
          <StackPanel x:Name="EditorPage" Visibility="Collapsed" Margin="18,0,18,18">
            <TextBlock Text="从 SSH 配置导入" Style="{StaticResource Field}" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <ComboBox x:Name="HostAliases" SelectionChanged="ImportAlias" AutomationProperties.Name="导入 SSH Host" ToolTip="从 SSH 配置选择 Host，并填入其中写明的用户名、端口和私钥。" />
              <Button Grid.Column="1" Content="新建" Click="NewServer" Margin="8,0,0,0" AutomationProperties.Name="新建连接" />
            </Grid>
            <TextBlock Text="名称" Style="{StaticResource Field}" /><TextBox x:Name="NameInput" AutomationProperties.Name="名称" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,6">
              <TextBlock Text="SSH 主机" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Style="{StaticResource HelpMark}" RequestBringIntoView="BringHelpRowIntoView" AutomationProperties.Name="SSH 主机说明" ToolTip="填写 SSH 配置中的 Host 别名、域名或 IP。不要包含用户名，也不要填写完整的 ssh 命令。" />
            </StackPanel>
            <TextBox x:Name="HostInput" AutomationProperties.Name="SSH Host" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal" Margin="0,16,0,6">
                  <TextBlock Text="用户名" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Text="可选" Margin="5,0,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                  <Button Style="{StaticResource HelpMark}" RequestBringIntoView="BringHelpRowIntoView" AutomationProperties.Name="SSH 用户说明" ToolTip="留空则沿用 SSH 配置。若配置未指定用户名，则使用当前 Windows 用户。从 SSH Host 导入时，仅填入配置中写明的用户名。" />
                </StackPanel>
                <TextBox x:Name="UserInput" AutomationProperties.Name="SSH 用户" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,16,0,6">
                  <TextBlock Text="SSH 端口" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Text="可选" Margin="5,0,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                  <Button Style="{StaticResource HelpMark}" RequestBringIntoView="BringHelpRowIntoView" AutomationProperties.Name="SSH 端口说明" ToolTip="留空则沿用 SSH 配置，通常为 22。这是 SSH 登录端口，不是服务器代理端口。" />
                </StackPanel>
                <TextBox x:Name="SshPortInput" Typography.NumeralAlignment="Tabular" AutomationProperties.Name="SSH 端口" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,6">
              <TextBlock Text="私钥路径" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Text="可选" Margin="5,0,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
              <Button Style="{StaticResource HelpMark}" RequestBringIntoView="BringHelpRowIntoView" AutomationProperties.Name="私钥路径说明" ToolTip="留空则沿用 SSH 配置和 ssh-agent。此处只保存路径，不保存密码。加密私钥需先用 ssh-add 加入 ssh-agent。导入时仅填入配置中的第一把私钥。" />
            </StackPanel>
            <TextBox x:Name="IdentityInput" AutomationProperties.Name="私钥文件路径" />
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20,0,4" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal" Margin="0,16,0,6">
                  <TextBlock Text="本地代理端口" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button Style="{StaticResource HelpMark}" RequestBringIntoView="BringHelpRowIntoView" AutomationProperties.Name="本地代理端口说明" ToolTip="Windows 上现有代理的监听端口，常见值为 7890。Portkey 不安装或修改该代理，只将此本机地址转发到服务器。" />
                </StackPanel>
                <TextBox x:Name="LocalPortInput" Typography.NumeralAlignment="Tabular" AutomationProperties.Name="本地代理端口" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,16,0,6">
                  <TextBlock Text="服务器端口" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button Style="{StaticResource HelpMark}" RequestBringIntoView="BringHelpRowIntoView" AutomationProperties.Name="服务器端口说明" ToolTip="仅在服务器的 127.0.0.1 上监听，供该机器本机使用，不向公网开放。不要填写 SSH 端口 22。有效范围为 1024–65535。若提示端口被占用，请更换未占用的端口后保存，不要结束无法确认的进程。" />
                </StackPanel>
                <TextBox x:Name="RemotePortInput" Typography.NumeralAlignment="Tabular" AutomationProperties.Name="远程代理端口" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,6">
              <TextBlock Text="代理协议" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Style="{StaticResource HelpMark}" RequestBringIntoView="BringHelpRowIntoView" AutomationProperties.Name="代理协议说明" ToolTip="混合模式同时提供 HTTP 与 SOCKS5。若只需其中一种，请在此更改并保存，服务器上的自动配置会随之更新。" />
            </StackPanel>
            <ComboBox x:Name="ProtocolInput" AutomationProperties.Name="代理协议">
              <ComboBox.ItemTemplate><DataTemplate>
                <TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Text" Value="HTTP + SOCKS5" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding}" Value="Http"><Setter Property="Text" Value="HTTP" /></DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Socks5"><Setter Property="Text" Value="SOCKS5" /></DataTrigger>
                  </Style.Triggers>
                </Style></TextBlock.Style></TextBlock>
              </DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20,0,10" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <CheckBox x:Name="AutoInput" Grid.ColumnSpan="3" AutomationProperties.Name="启动时自动连接" />
              <TextBlock x:Name="AutoLabel" Text="启动时自动连接" FontSize="15" VerticalAlignment="Center" TextWrapping="NoWrap" IsHitTestVisible="False" />
              <Button Grid.Column="1" Style="{StaticResource HelpMark}" RequestBringIntoView="BringHelpRowIntoView" AutomationProperties.Name="启动时自动连接说明" ToolTip="下次启动 Portkey 时自动连接此服务器。仅打开开关不会立即连接；正在运行的连接会在保存后按新设置重连。" />
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <CheckBox x:Name="SyncInput" Grid.ColumnSpan="3" Checked="SyncChanged" Unchecked="SyncChanged" AutomationProperties.Name="新终端自动使用此代理" />
              <TextBlock x:Name="SyncLabel" Text="新终端使用代理" FontSize="15" VerticalAlignment="Center" TextWrapping="NoWrap" IsHitTestVisible="False" />
              <Button Grid.Column="1" Style="{StaticResource HelpMark}" RequestBringIntoView="BringHelpRowIntoView" AutomationProperties.Name="新终端代理说明" ToolTip="保存时，将代理地址写入服务器的 Bash 与 systemd 用户环境，已打开的终端和运行中的服务不变。关闭并保存后移除 Portkey 写入的配置。若提示没有同步，新终端仍使用旧地址。" />
            </Grid>
            <Button Content="检测本地代理" Click="CheckLocalProxy" Margin="0,16,0,0" AutomationProperties.Name="检测本地代理" ToolTip="使用固定的 HTTPS 地址检查本机代理是否可用，不检查服务器。" />
            <Button Content="首次 SSH 认证" Click="InitializeSsh" Margin="0,10,0,0" ToolTip="首次连接新主机时，先向管理员核对指纹，再在打开的窗口中确认。" AutomationProperties.Name="首次 SSH 认证" />
            <Button x:Name="DeleteButton" Foreground="{DynamicResource DangerBrush}" Background="Transparent" BorderBrush="Transparent" Content="删除此连接" Click="DeleteServer" Margin="0,10,0,0" AutomationProperties.Name="删除此连接" ToolTip="删除本机连接，并尝试清除服务器上由 Portkey 写入的代理配置。" />
          </StackPanel>
          <Grid x:Name="LogsPage" Visibility="Collapsed" Height="{Binding ActualHeight, ElementName=PageScroll}">
            <TextBox x:Name="LogsText" Style="{StaticResource DocumentBox}" AutomationProperties.Name="连接日志" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" FontFamily="{StaticResource MonoFont}" FontSize="13" Padding="12" Margin="18,8,18,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
          </Grid>
        </Grid>
      </ScrollViewer>
      <Border x:Name="ActionFooter" Grid.Row="2" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
        <Grid IsEnabled="{Binding NotBusy}">
          <StackPanel x:Name="EditorActions" Visibility="Collapsed">
            <Button x:Name="FollowUpButton" Content="覆盖这段配置并保存" Style="{StaticResource AccentButton}" Click="FollowUp" Visibility="Collapsed" Margin="0,0,0,8" AutomationProperties.Name="覆盖这段配置并保存" />
            <Button x:Name="SaveButton" Content="保存并同步" Style="{StaticResource AccentButton}" Click="SaveServer" AutomationProperties.Name="保存连接" />
          </StackPanel>
          <UniformGrid x:Name="LogActions" Visibility="Collapsed" Columns="3">
            <Button Content="刷新" Click="RefreshLogs" Margin="0,0,4,0" /><Button Content="复制诊断" Click="CopyDiagnostics" Margin="4,0" /><Button Content="日志目录" Click="OpenLogFolder" Margin="4,0,0,0" />
          </UniformGrid>
        </Grid>
      </Border>
      <Border x:Name="Notice" Grid.RowSpan="3" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="340" Margin="16,254,16,0" Panel.ZIndex="4" IsHitTestVisible="True">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding NoticeText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Border Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,3">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="3" CornerRadius="1.5" Margin="0,1,10,1">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding NoticeTone}" Value="warning"><Setter Property="Visibility" Value="Visible" /><Setter Property="Background" Value="{DynamicResource NoticeWarningBrush}" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding NoticeText}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="300" VerticalAlignment="Center" ToolTip="{Binding NoticeDetail}" />
          </Grid>
        </Border>
      </Border>
    </Grid>
    </AdornerDecorator>
  </Border>
</Window>
