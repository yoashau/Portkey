<Window x:Class="Portkey.App.TrayPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Portkey" Width="380" Height="540" MaxHeight="540" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="15" UseLayoutRounding="True" SnapsToDevicePixels="True" KeyDown="OnKeyDown">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="8" GlassFrameThickness="-1" /></shell:WindowChrome.WindowChrome>
  <Border x:Name="Surface" Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border x:Name="NavigationHeader" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,8,16,8">
        <DockPanel LastChildFill="True">
          <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Click="GoHome" ToolTip="返回" AutomationProperties.Name="返回">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" />
          </Button>
          <TextBlock x:Name="PageTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="False">
        <Grid x:Name="Controls" IsEnabled="{Binding NotBusy}" MinHeight="{Binding ActualHeight, ElementName=PageScroll}">
          <Grid.RenderTransform><TranslateTransform x:Name="PageTranslation" /></Grid.RenderTransform>
          <Grid x:Name="HomePage" Margin="0,8,0,6">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="16,8,16,16">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <ComboBox x:Name="ServerSelector" ItemsSource="{Binding Servers}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" FontSize="20" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" AutomationProperties.Name="选择服务器" />
              <Grid x:Name="ConnectionCard" Grid.Row="1" VerticalAlignment="Center" Margin="0,16">
                <StackPanel>
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;" FontSize="36" Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Text="{Binding Selected.Label}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" ToolTip="{Binding Selected.Detail}" />
                  <TextBlock Text="{Binding Selected.EndpointLabel}" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Selected.EndpointLabel}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="12,14,12,0">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="本地代理" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding Selected.Profile.LocalPort}" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                      <TextBlock Grid.Column="1" Style="{StaticResource Glyph}" Text="&#xE72A;" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="远程端口" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding Selected.Profile.RemotePort}" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Grid>
              <Border x:Name="EmptyState" Grid.RowSpan="3" VerticalAlignment="Center" Margin="12,16" Padding="0" Background="Transparent">
                <StackPanel>
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;" FontSize="48" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" />
                  <TextBlock x:Name="EmptyText" Text="连接你的服务器" FontSize="24" FontWeight="SemiBold" Margin="0,22,0,0" />
                  <TextBlock Text="让本地代理抵达远端" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" />
                  <Button x:Name="AddServerButton" Content="添加服务器" Height="44" Style="{StaticResource AccentButton}" Click="OpenEditor" AutomationProperties.Name="添加服务器" Margin="0,28,0,0" />
                </StackPanel>
              </Border>
              <Grid x:Name="ConnectionActions" Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                <Button x:Name="ToggleButton" Height="44" Content="{Binding Selected.ToggleLabel}" Style="{StaticResource AccentButton}" Click="ToggleConnection" Margin="0,0,6,0" />
                <Button x:Name="ReconnectButton" Grid.Column="1" Height="44" Padding="0" Click="Reconnect" ToolTip="重新连接" AutomationProperties.Name="重新连接"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" /></Button>
              </Grid>
            </Grid>
            <StackPanel Grid.Row="1">
              <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,2,0,4" />
              <Button x:Name="DeploymentNav" Style="{StaticResource Nav}" Click="OpenDeployment" AutomationProperties.Name="服务器配置">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE968;" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="服务器配置" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="12" />
                </Grid>
              </Button>
              <Button Style="{StaticResource Nav}" Click="OpenEditor" AutomationProperties.Name="连接设置">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE716;" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="连接设置" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="12" />
                </Grid>
              </Button>
              <Button Style="{StaticResource Nav}" Click="OpenLogs" AutomationProperties.Name="连接日志">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="连接日志" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="12" />
                </Grid>
              </Button>
            </StackPanel>
          </Grid>
          <StackPanel x:Name="EditorPage" Visibility="Collapsed" Margin="16,0,16,16">
            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <ComboBox x:Name="HostAliases" SelectionChanged="ImportAlias" AutomationProperties.Name="导入 SSH Host" ToolTip="从已有 SSH Host 导入" Margin="0,0,8,0" />
              <Button Grid.Column="1" Content="新建" Click="NewServer" />
            </Grid>
            <TextBlock Text="名称" Style="{StaticResource Field}" /><TextBox x:Name="NameInput" AutomationProperties.Name="名称" />
            <TextBlock Text="SSH Host / 地址" Style="{StaticResource Field}" /><TextBox x:Name="HostInput" AutomationProperties.Name="SSH Host" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,6,0"><TextBlock Text="用户名（可选）" Style="{StaticResource Field}" /><TextBox x:Name="UserInput" AutomationProperties.Name="SSH 用户" ToolTip="留空沿用 SSH 配置" /></StackPanel>
              <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="SSH 端口（可选）" Style="{StaticResource Field}" /><TextBox x:Name="SshPortInput" AutomationProperties.Name="SSH 端口" ToolTip="留空沿用 SSH 配置" /></StackPanel>
            </Grid>
            <TextBlock Text="私钥路径（可选）" Style="{StaticResource Field}" /><TextBox x:Name="IdentityInput" AutomationProperties.Name="私钥文件路径" ToolTip="只保存文件路径，不读取或保存密钥正文" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,6,0"><TextBlock Text="本地代理端口" Style="{StaticResource Field}" /><TextBox x:Name="LocalPortInput" AutomationProperties.Name="本地代理端口" /></StackPanel>
              <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="远程监听端口" Style="{StaticResource Field}" /><TextBox x:Name="RemotePortInput" AutomationProperties.Name="远程代理端口" /></StackPanel>
            </Grid>
            <TextBlock Text="代理协议" Style="{StaticResource Field}" /><ComboBox x:Name="ProtocolInput" AutomationProperties.Name="代理协议" />
            <CheckBox x:Name="AutoInput" Content="启动时自动连接" Margin="0,14,0,0" />
            <Expander x:Name="HealthOptions" Header="健康检测" Expanded="DisclosureChanged" Collapsed="DisclosureChanged" Margin="0,16,0,0" FontWeight="SemiBold">
              <StackPanel>
                <TextBlock Text="检测地址（HTTPS）" Style="{StaticResource Field}" /><TextBox x:Name="CheckUrlInput" AutomationProperties.Name="检测 HTTPS 地址" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,6,0"><TextBlock Text="预期状态码" Style="{StaticResource Field}" /><TextBox x:Name="StatusInput" AutomationProperties.Name="预期 HTTP 状态码" /></StackPanel>
                  <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="超时（秒）" Style="{StaticResource Field}" /><TextBox x:Name="TimeoutInput" AutomationProperties.Name="检测超时秒数" /></StackPanel>
                </Grid>
                <Button Content="检测本地代理" Click="CheckLocalProxy" Margin="0,14,0,0" />
              </StackPanel>
            </Expander>
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,12" />
            <Button Content="首次 SSH 认证" Click="InitializeSsh" ToolTip="先向管理员核对主机指纹；加密私钥先加入 Windows ssh-agent。" />
            <Button Content="移除本地连接" Click="DeleteServer" Margin="0,8,0,0" ToolTip="停止此连接并移除本地配置；服务器文件保留。" />
          </StackPanel>
          <StackPanel x:Name="DeployPage" Visibility="Collapsed" Margin="16,14,16,16">
            <TextBlock Text="{Binding Selected.Endpoint}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
            <UniformGrid Columns="2"><Button Content="安装 / 修复预览" Click="InspectInstall" Margin="0,0,4,0" /><Button Content="卸载预览" Click="InspectUninstall" Margin="4,0,0,0" /></UniformGrid>
            <TextBox x:Name="PreviewText" Style="{StaticResource DocumentBox}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" FontFamily="Consolas, Microsoft YaHei UI" FontSize="14" Height="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,14,0,0" AutomationProperties.Name="部署差异预览" />
            <Expander x:Name="BackupOptions" Header="备份与修复" Expanded="DisclosureChanged" Collapsed="DisclosureChanged" Margin="0,16,0,0" FontWeight="SemiBold">
              <StackPanel>
                <Button Content="恢复备份预览" Click="PreviewRestore" Margin="0,8,0,0" />
                <CheckBox x:Name="AllowEditedInput" Margin="0,8" Checked="InvalidatePlan" Unchecked="InvalidatePlan"><TextBlock Text="允许替换手动编辑的 Portkey 配置" /></CheckBox>
                <Button Content="恢复中断事务" Click="RecoverTransaction" ToolTip="勾选底部确认后回滚中断事务中的自有修改；遇到新的用户编辑会停止。" />
              </StackPanel>
            </Expander>
          </StackPanel>
          <Grid x:Name="LogsPage" Visibility="Collapsed" Height="{Binding ActualHeight, ElementName=PageScroll}">
            <TextBox x:Name="LogsText" Style="{StaticResource DocumentBox}" AutomationProperties.Name="连接日志" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" FontFamily="Consolas, Microsoft YaHei UI" FontSize="14" Margin="16,14,16,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
          </Grid>
        </Grid>
      </ScrollViewer>
      <Border x:Name="ActionFooter" Grid.Row="2" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
        <Grid IsEnabled="{Binding NotBusy}">
          <Button x:Name="SaveButton" Content="保存连接" Style="{StaticResource AccentButton}" Click="SaveServer" Visibility="Collapsed" />
          <StackPanel x:Name="DeployActions" Visibility="Collapsed">
            <CheckBox x:Name="ConfirmInput" Content="已审阅预览，确认应用变更" Margin="0,0,0,8" />
            <Button x:Name="ApplyButton" Content="应用变更" Style="{StaticResource AccentButton}" Click="ApplyPlan" IsEnabled="False" />
          </StackPanel>
          <UniformGrid x:Name="LogActions" Visibility="Collapsed" Columns="3">
            <Button Content="刷新" Click="RefreshLogs" Margin="0,0,4,0" /><Button Content="复制诊断" Click="CopyDiagnostics" Margin="4,0" /><Button Content="日志目录" Click="OpenLogFolder" Margin="4,0,0,0" />
          </UniformGrid>
        </Grid>
      </Border>
      <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
        <StackPanel>
          <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock Text="{Binding Message}" FontSize="14" /></ScrollViewer>
          <Button x:Name="CancelButton" Content="取消操作" Visibility="Collapsed" Click="CancelOperation" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
